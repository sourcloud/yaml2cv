---
version: 2.0.2
title: visual editor blocks de
---
<form class="visual-editor" hx-post="/editor/visual/update" hx-swap="none" hx-sync="this:queue all" hx-trigger="input delay:300ms, flush" id="visual-form"><div class="ui-alert ui-alert--info" role="status"><p class="ui-alert__title">Bearbeiten hier überschreiben das YAML</p><div class="ui-alert__body">Die erste Änderung in diesem Modus generiert das YAML in einheitlicher Form neu; Kommentare und eigene Formatierungen gehen verloren.</div></div><fieldset class="ui-block"><legend class="ui-block__title">Stil</legend><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Design</span><select class="ui-field__input" name="style.theme"><option value>Default (classic)</option><option value="classic">classic</option><option selected value="minimal">minimal</option></select></label><label class="ui-field"><span class="ui-field__label">Akzentfarbe</span><select class="ui-field__input" name="style.color"><option selected value>Default (blue)</option><option value="black">black</option><option value="blue">blue</option><option value="burgundy">burgundy</option><option value="green">green</option><option value="grey">grey</option><option value="orange">orange</option><option value="purple">purple</option><option value="red">red</option></select></label><label class="ui-field"><span class="ui-field__label">Papierformat</span><select class="ui-field__input" name="style.paper"><option selected value>Default (a4)</option><option value="a4">a4</option><option value="letter">letter</option></select></label></div></fieldset><fieldset class="ui-block"><legend class="ui-block__title">Person</legend><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Name<span class="ui-field__required"> (Pflichtfeld)</span></span><input aria-required="true" class="ui-field__input" name="person.name" type="text" value="Jane &lt;Roe&gt;"></label><label class="ui-field"><span class="ui-field__label">Tätigkeit</span><input class="ui-field__input" name="person.title" type="text" value></label><label class="ui-field"><span class="ui-field__label">Adresse</span><input class="ui-field__input" name="person.address" type="text" value></label></div></fieldset><fieldset class="ui-block"><legend class="ui-block__title">Kontakt</legend><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">E-Mail</span><input class="ui-field__input" name="contact.email" type="text" value></label><label class="ui-field"><span class="ui-field__label">Telefon</span><input class="ui-field__input" name="contact.phone" type="text" value></label><label class="ui-field"><span class="ui-field__label">Website</span><input class="ui-field__input" name="contact.website" type="text" value></label><div aria-label="Links" class="ui-block-list" role="group"><fieldset class="ui-block"><legend class="ui-block__title">Link 1</legend><div class="ui-block__actions"><div class="visual-editor__move"><button aria-hidden="true" class="ui-button ui-button--quiet" disabled type="button">↑</button><button aria-hidden="true" class="ui-button ui-button--quiet" disabled type="button">↓</button></div><button aria-label="Link 1 entfernen" class="ui-button ui-button--quiet visual-editor__remove" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Link 1 entfernen" type="button" value="remove:contact.links.0">Entfernen</button></div><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Label<span class="ui-field__required"> (Pflichtfeld)</span></span><input aria-required="true" class="ui-field__input" name="contact.links.0.label" type="text" value="GitHub"></label><label class="ui-field"><span class="ui-field__label">URL<span class="ui-field__required"> (Pflichtfeld)</span></span><input aria-required="true" class="ui-field__input" name="contact.links.0.url" type="text" value="https://x"></label></div></fieldset><div class="visual-editor__add"><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add:contact.links">Link hinzufügen</button></div></div></div></fieldset><div aria-label="Abschnitte" class="ui-block-list" role="group"><fieldset class="ui-block"><legend class="ui-block__title">Abschnitt „Datierte Einträge“</legend><div class="ui-block__actions"><div class="visual-editor__move"><button aria-hidden="true" class="ui-button ui-button--quiet" disabled type="button">↑</button><button aria-label="Abschnitt 1 nach unten verschieben" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Abschnitt 1 nach unten verschieben" type="button" value="down:sections.0">↓</button></div><button aria-label="Abschnitt 1 entfernen" class="ui-button ui-button--quiet visual-editor__remove" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Abschnitt 1 entfernen" type="button" value="remove:sections.0">Entfernen</button></div><div class="ui-block__body"><input name="sections.0.kind" type="hidden" value="entries"><label class="ui-field"><span class="ui-field__label">Name des Abschnitts<span class="ui-field__required"> (Pflichtfeld)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.name" type="text" value="Work"></label><div aria-label="Datierte Einträge" class="ui-block-list" role="group"><fieldset class="ui-block"><legend class="ui-block__title">Datierter Eintrag 1</legend><div class="ui-block__actions"><div class="visual-editor__move"><button aria-hidden="true" class="ui-button ui-button--quiet" disabled type="button">↑</button><button aria-label="Datierter Eintrag 1 nach unten verschieben" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Datierter Eintrag 1 nach unten verschieben" type="button" value="down:sections.0.entries.0">↓</button></div><button aria-label="Datierter Eintrag 1 entfernen" class="ui-button ui-button--quiet visual-editor__remove" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Datierter Eintrag 1 entfernen" type="button" value="remove:sections.0.entries.0">Entfernen</button></div><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Zeitraum<span class="ui-field__required"> (Pflichtfeld)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.0.timespan" type="text" value></label><label class="ui-field"><span class="ui-field__label">Tätigkeit<span class="ui-field__required"> (Pflichtfeld)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.0.title" type="text" value="One"></label><label class="ui-field"><span class="ui-field__label">Arbeitgeber, Hochschule, o.ä.</span><input class="ui-field__input" name="sections.0.entries.0.organization" type="text" value></label><label class="ui-field"><span class="ui-field__label">Tätigkeitsstätte</span><input class="ui-field__input" name="sections.0.entries.0.location" type="text" value></label><div aria-label="Stichpunkte" class="ui-block-list" role="group"><div class="visual-editor__row"><label class="ui-field"><span class="ui-field__label">Stichpunkt 1<span class="ui-field__required"> (Pflichtfeld)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.0.bullets.0" type="text" value="x"></label><div class="visual-editor__row-actions"><div class="visual-editor__move"><button aria-hidden="true" class="ui-button ui-button--quiet" disabled type="button">↑</button><button aria-label="Stichpunkt 1 nach unten verschieben" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Stichpunkt 1 nach unten verschieben" type="button" value="down:sections.0.entries.0.bullets.0">↓</button></div><button aria-label="Stichpunkt 1 entfernen" class="ui-button ui-button--quiet visual-editor__remove" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Stichpunkt 1 entfernen" type="button" value="remove:sections.0.entries.0.bullets.0">Entfernen</button></div></div><div class="visual-editor__row"><label class="ui-field"><span class="ui-field__label">Stichpunkt 2<span class="ui-field__required"> (Pflichtfeld)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.0.bullets.1" type="text" value="y"></label><div class="visual-editor__row-actions"><div class="visual-editor__move"><button aria-label="Stichpunkt 2 nach oben verschieben" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Stichpunkt 2 nach oben verschieben" type="button" value="up:sections.0.entries.0.bullets.1">↑</button><button aria-hidden="true" class="ui-button ui-button--quiet" disabled type="button">↓</button></div><button aria-label="Stichpunkt 2 entfernen" class="ui-button ui-button--quiet visual-editor__remove" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Stichpunkt 2 entfernen" type="button" value="remove:sections.0.entries.0.bullets.1">Entfernen</button></div></div><div class="visual-editor__add"><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add:sections.0.entries.0.bullets">Stichpunkt hinzufügen</button></div></div></div></fieldset>
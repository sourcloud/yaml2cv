{"labels":{"default":"Default:"},"mappings":{"":[{"key":"schema_version","requirement":"required","description":"Schema version. Must be `1`.","values":[],"default":null,"nested":false},{"key":"language","requirement":"optional","description":"Language of the CV as a two-letter code such as `en` or `de`; default `en`. Sets the language of the PDF for screening software, hyphenation and quotes.","values":[],"default":null,"nested":false},{"key":"style","requirement":"optional","description":"Visual settings; see `style`.","values":[],"default":null,"nested":true},{"key":"person","requirement":"required","description":"Who the CV is about; see `person`.","values":[],"default":null,"nested":true},{"key":"contact","requirement":"optional","description":"Contact details; see `contact`.","values":[],"default":null,"nested":true},{"key":"sections","requirement":"required","description":"The sections in the order they appear; see `sections[]`. May be empty: `[]`.","values":[],"default":null,"nested":true}],"style":[{"key":"theme","requirement":"optional","description":"Layout and typography.","values":["classic","minimal","studio","spotlight","cover"],"default":"classic","nested":false},{"key":"color","requirement":"optional","description":"Accent colour.","values":["black","blue","burgundy","green","grey","orange","purple","red"],"default":"blue","nested":false},{"key":"paper","requirement":"optional","description":"Paper size.","values":["a4","letter"],"default":"a4","nested":false},{"key":"photo_shape","requirement":"optional","description":"Crop of the profile photo.","values":["rectangle","rounded","circle"],"default":"rectangle","nested":false}],"person":[{"key":"name","requirement":"required","description":"Full name, shown as the heading.","values":[],"default":null,"nested":false},{"key":"title","requirement":"optional","description":"Job title or tagline under the name.","values":[],"default":null,"nested":false},{"key":"address","requirement":"optional","description":"Postal address.","values":[],"default":null,"nested":false},{"key":"photo","requirement":"optional","description":"Profile photo, shown next to the name: a JPEG or PNG of at most 512 KiB and 4000 × 4000 pixels as a data URI, `data:image/jpeg;base64,…`. The editor's photo button creates it. The photo is not stored by the service.","values":[],"default":null,"nested":false}],"contact":[{"key":"email","requirement":"optional","description":"Email address.","values":[],"default":null,"nested":false},{"key":"phone","requirement":"optional","description":"Phone number.","values":[],"default":null,"nested":false},{"key":"website","requirement":"optional","description":"Website address.","values":[],"default":null,"nested":false},{"key":"links","requirement":"optional","description":"Further links; see `contact.links[]`.","values":[],"default":null,"nested":true}],"contact.links[]":[{"key":"label","requirement":"required","description":"Text shown, for example `GitHub`.","values":[],"default":null,"nested":false},{"key":"url","requirement":"required","description":"Address the link points to.","values":[],"default":null,"nested":false}],"sections[]":[{"key":"name","requirement":"required","description":"Section heading.","values":[],"default":null,"nested":false},{"key":"kind","requirement":"optional","description":"What the section contains.","values":["entries","skills","text"],"default":"entries","nested":false},{"key":"entries","requirement":"if kind is entries","description":"List of dated items; see `sections[].entries[]`.","values":[],"default":null,"nested":true},{"key":"items","requirement":"if kind is skills","description":"List of skills or languages; see `sections[].items[]`.","values":[],"default":null,"nested":true},{"key":"text","requirement":"if kind is text","description":"A paragraph of free text.","values":[],"default":null,"nested":false}],"sections[].entries[]":[{"key":"timespan","requirement":"required","description":"Period as text, for example 
---
version: 2.0.2
title: visual editor blocks
---
<form class="visual-editor" hx-post="/editor/visual/update" hx-swap="none" hx-sync="this:queue all" hx-trigger="input delay:300ms" id="visual-form"><div class="ui-alert ui-alert--info" role="status"><p class="ui-alert__title">Editing here rewrites the YAML</p><div class="ui-alert__body">The first change made with the blocks rewrites the YAML in a uniform layout; comments and custom formatting are removed.</div></div><fieldset class="ui-block"><legend class="ui-block__title">Style</legend><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Theme</span><select class="ui-field__input" name="style.theme"><option value>Default (classic)</option><option value="classic">classic</option><option selected value="minimal">minimal</option></select></label><label class="ui-field"><span class="ui-field__label">Colour</span><select class="ui-field__input" name="style.color"><option selected value>Default (blue)</option><option value="black">black</option><option value="blue">blue</option><option value="burgundy">burgundy</option><option value="green">green</option><option value="grey">grey</option><option value="orange">orange</option><option value="purple">purple</option><option value="red">red</option></select></label><label class="ui-field"><span class="ui-field__label">Paper</span><select class="ui-field__input" name="style.paper"><option selected value>Default (a4)</option><option value="a4">a4</option><option value="letter">letter</option></select></label></div></fieldset><fieldset class="ui-block"><legend class="ui-block__title">Person</legend><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Name<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="person.name" type="text" value="Jane &lt;Roe&gt;"></label><label class="ui-field"><span class="ui-field__label">Title</span><input class="ui-field__input" name="person.title" type="text" value></label><label class="ui-field"><span class="ui-field__label">Address</span><input class="ui-field__input" name="person.address" type="text" value></label></div></fieldset><fieldset class="ui-block"><legend class="ui-block__title">Contact</legend><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Email</span><input class="ui-field__input" name="contact.email" type="text" value></label><label class="ui-field"><span class="ui-field__label">Phone</span><input class="ui-field__input" name="contact.phone" type="text" value></label><label class="ui-field"><span class="ui-field__label">Website</span><input class="ui-field__input" name="contact.website" type="text" value></label><div aria-label="Links" class="ui-block-list" role="group"><fieldset class="ui-block"><legend class="ui-block__title">Link 1</legend><div class="ui-block__actions"><button aria-label="Remove link 1" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove link 1" type="button" value="remove:contact.links.0">Remove</button></div><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Label<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="contact.links.0.label" type="text" value="GitHub"></label><label class="ui-field"><span class="ui-field__label">URL<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="contact.links.0.url" type="text" value="https://x"></label></div></fieldset><div class="visual-editor__add"><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add:contact.links">Add link</button></div></div></div></fieldset><div aria-label="Sections" class="ui-block-list" role="group"><fieldset class="ui-block"><legend class="ui-block__title">Entries section</legend><div class="ui-block__actions"><button aria-label="Move section 1 down" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Move section 1 down" type="button" value="down:sections.0">↓</button><button aria-label="Remove section 1" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove section 1" type="button" value="remove:sections.0">Remove</button></div><div class="ui-block__body"><input name="sections.0.kind" type="hidden" value="entries"><label class="ui-field"><span class="ui-field__label">Heading<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.name" type="text" value="Work"></label><div aria-label="Entries" class="ui-block-list" role="group"><fieldset class="ui-block"><legend class="ui-block__title">Entry 1</legend><div class="ui-block__actions"><button aria-label="Move entry 1 down" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Move entry 1 down" type="button" value="down:sections.0.entries.0">↓</button><button aria-label="Remove entry 1" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove entry 1" type="button" value="remove:sections.0.entries.0">Remove</button></div><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Timespan<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.0.timespan" type="text" value></label><label class="ui-field"><span class="ui-field__label">Title<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.0.title" type="text" value="One"></label><label class="ui-field"><span class="ui-field__label">Organisation</span><input class="ui-field__input" name="sections.0.entries.0.organization" type="text" value></label><label class="ui-field"><span class="ui-field__label">Location</span><input class="ui-field__input" name="sections.0.entries.0.location" type="text" value></label><div aria-label="Bullets" class="ui-block-list" role="group"><div class="visual-editor__row"><label class="ui-field"><span class="ui-field__label">Bullet 1<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.0.bullets.0" type="text" value="x"></label><div class="visual-editor__row-actions"><button aria-label="Move bullet 1 down" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Move bullet 1 down" type="button" value="down:sections.0.entries.0.bullets.0">↓</button><button aria-label="Remove bullet 1" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove bullet 1" type="button" value="remove:sections.0.entries.0.bullets.0">Remove</button></div></div><div class="visual-editor__row"><label class="ui-field"><span class="ui-field__label">Bullet 2<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.0.bullets.1" type="text" value="y"></label><div class="visual-editor__row-actions"><button aria-label="Move bullet 2 up" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Move bullet 2 up" type="button" value="up:sections.0.entries.0.bullets.1">↑</button><button aria-label="Remove bullet 2" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove bullet 2" type="button" value="remove:sections.0.entries.0.bullets.1">Remove</button></div></div><div class="visual-editor__add"><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add:sections.0.entries.0.bullets">Add bullet</button></div></div></div></fieldset><fieldset class="ui-block"><legend class="ui-block__title">Entry 2</legend><div class="ui-block__actions"><button aria-label="Move entry 2 up" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Move entry 2 up" type="button" value="up:sections.0.entries.1">↑</button><button aria-label="Remove entry 2" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove entry 2" type="button" value="remove:sections.0.entries.1">Remove</button></div><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Timespan<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.1.timespan" type="text" value></label><label class="ui-field"><span class="ui-field__label">Title<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.0.entries.1.title" type="text" value="Two"></label><label class="ui-field"><span class="ui-field__label">Organisation</span><input class="ui-field__input" name="sections.0.entries.1.organization" type="text" value></label><label class="ui-field"><span class="ui-field__label">Location</span><input class="ui-field__input" name="sections.0.entries.1.location" type="text" value></label><div aria-label="Bullets" class="ui-block-list" role="group"><div class="visual-editor__add"><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add:sections.0.entries.1.bullets">Add bullet</button></div></div></div></fieldset><div class="visual-editor__add"><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add:sections.0.entries">Add entry</button></div></div></div></fieldset><fieldset class="ui-block"><legend class="ui-block__title">Skills section</legend><div class="ui-block__actions"><button aria-label="Move section 2 up" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Move section 2 up" type="button" value="up:sections.1">↑</button><button aria-label="Move section 2 down" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Move section 2 down" type="button" value="down:sections.1">↓</button><button aria-label="Remove section 2" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove section 2" type="button" value="remove:sections.1">Remove</button></div><div class="ui-block__body"><input name="sections.1.kind" type="hidden" value="skills"><label class="ui-field"><span class="ui-field__label">Heading<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.1.name" type="text" value="Langs"></label><div aria-label="Skills" class="ui-block-list" role="group"><fieldset class="ui-block"><legend class="ui-block__title">Skill 1</legend><div class="ui-block__actions"><button aria-label="Remove skill 1" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove skill 1" type="button" value="remove:sections.1.items.0">Remove</button></div><div class="ui-block__body"><label class="ui-field"><span class="ui-field__label">Name<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.1.items.0.name" type="text" value="English"></label><label class="ui-field"><span class="ui-field__label">Level</span><input class="ui-field__input" name="sections.1.items.0.level" type="text" value></label></div></fieldset><div class="visual-editor__add"><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add:sections.1.items">Add skill</button></div></div></div></fieldset><fieldset class="ui-block"><legend class="ui-block__title">Text section</legend><div class="ui-block__actions"><button aria-label="Move section 3 up" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Move section 3 up" type="button" value="up:sections.2">↑</button><button aria-label="Remove section 3" class="ui-button ui-button--quiet" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" title="Remove section 3" type="button" value="remove:sections.2">Remove</button></div><div class="ui-block__body"><input name="sections.2.kind" type="hidden" value="text"><label class="ui-field"><span class="ui-field__label">Heading<span class="ui-field__required"> (required)</span></span><input aria-required="true" class="ui-field__input" name="sections.2.name" type="text" value="About"></label><label class="ui-field"><span class="ui-field__label">Text<span class="ui-field__required"> (required)</span></span><textarea aria-required="true" class="ui-field__input ui-field__input--multiline" name="sections.2.text" rows="5">Hi</textarea></label></div></fieldset><div class="visual-editor__add"><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add-section:entries">Add entries section</button><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add-section:skills">Add skills section</button><button class="ui-button ui-button--secondary" hx-post="/editor/visual/update" hx-swap="outerHTML" hx-sync="closest form:queue all" hx-target="#visual-form" name="op" type="button" value="add-section:text">Add text section</button></div></div></form>
